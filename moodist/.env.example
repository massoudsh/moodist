# محیط اجرا: development | production
MOODIST_ENV=development

# دیتابیس (در docker compose به‌صورت خودکار به سرویس db وصل می‌شود)
POSTGRES_USER=moodist
POSTGRES_PASSWORD=moodist
POSTGRES_DB=moodist

# کلید امنیتی — در production مقدار تصادفی و امن بگذارید
MOODIST_SECRET_KEY=dev-insecure-secret-change-me

# تحلیل تصویر: heuristic (توسعه) | llm (production)
MOODIST_VISION_PROVIDER=heuristic
MOODIST_LLM_API_URL=
MOODIST_LLM_API_KEY=
MOODIST_LLM_MODEL=

# ذخیره‌سازی تصویر: local (توسعه) | s3 (production)
MOODIST_STORAGE_BACKEND=local
MOODIST_S3_BUCKET=

# پورت API روی میزبان
API_PORT=8000
